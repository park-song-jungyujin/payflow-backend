    "/payouts/{run_id}/retry": {
      "post": {
        "summary": "Retry Payout",
        "description": "schema-contract.md §8 재발송 — FAILED run을 새 승인 토큰으로 다시 보낸다.\n사람이 먼저 POST /settlements/runs/{run_id}/approve로 FAILED→APPROVED 재승인해\n새 토큰을 받아야 한다(재발송도 돈이 나가는 행위라 approve의 CAS·캡 검사를 다시 탄다).\n이 라우트는 그 토큰으로 APPROVED→EXECUTING만 담당한다 — verify_and_burn_token은\n상태가 APPROVED이기만 하면 최초 송금과 재발송을 구분하지 않는다.",
        "operationId": "retry_payout_payouts__run_id__retry_post",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          },
          {
            "name": "X-Approval-Token",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Approval-Token"
            }
